# Copy to .env.local in this directory. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
AI_ENABLED=false
GEMINI_API_KEY=
# Explicit provider model ID. No paid model is chosen automatically.
GEMINI_MODEL=
# Independent random operator access code, at least 32 characters. Not the provider API key.
AI_ACCESS_TOKEN=
AI_DAILY_REQUEST_LIMIT=20
DATA_DIR=.data
